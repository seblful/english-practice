# Copy this file to .env and fill in the secrets: cp .env.example .env
#
# Precedence, highest first: real environment variables (shell, Docker, CI),
# then .env.<APP__ENVIRONMENT>, then .env. An exported variable is never
# overridden by this file, and a blank value counts as unset.
#
# Required: the Telegram token, the admin user ID, the selected provider's API
# key, and a database file that already exists. Everything commented out below
# shows the built-in default.
# Check a configuration with: uv run english-practice check

# --- Telegram (required) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=your_token_from_botfather
# Numeric Telegram user ID allowed to approve or reject other users. It must
# stay numeric: a non-numeric value fails validation before the bot starts.
# The bot refuses to start without it, since nobody could then be approved.
TELEGRAM_ADMIN_USER_ID=123456789

# --- LLM provider (required) -------------------------------------------------
# One of: dashscope, gemini, openrouter. Only this provider's key is needed.
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# DASHSCOPE_API_KEY=your_dashscope_key
# DASHSCOPE_MODEL=qwen3-vl-flash-2026-01-22

# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_PROXY=http://host:port

# LLM_REQUEST_TIMEOUT=60
# LLM_MAX_RETRIES=2

# --- Database (required) -----------------------------------------------------
# Relative paths resolve against the working directory, not the project root.
# In the container that is /app, and docker-compose mounts ./data there, so
# this is the file docs/deployment.md tells you to scp into place.
# Build one locally with: uv run scripts/database/populate.py --force
PATHS_DATABASE_PATH=data/production.db

# --- Environment -------------------------------------------------------------
# Names this deployment in logs. The .env.<name> overlay is picked before any
# file is read, so export APP__ENVIRONMENT from the shell, Dockerfile or CI to
# select one; setting it here only labels the app.
APP__ENVIRONMENT=production

# --- Bot behaviour -----------------------------------------------------------
# BOT_MAX_HISTORY_MESSAGES=20
# BOT_SESSION_IDLE_TTL_MINUTES=720

# --- Logging -----------------------------------------------------------------
# LOGGING__CONSOLE_LEVEL=INFO
# LOGGING__FILE_LEVEL=INFO
# LOGGING__LOG_FILE=logs/app.log

# --- LangSmith tracing -------------------------------------------------------
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=english-practice

# --- Extraction pipeline (not needed to run the bot) -------------------------
# OCR_API_KEY=your_mistral_key
# OCR_MODEL=mistral-ocr-latest
# BOOK_FILENAME=murphy.pdf
# IMAGES_PAGES_DPI=300
