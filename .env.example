# Every variable is <GROUP>_<FIELD>. Copy to .env and fill in what you use.
# No inline comments: KEY=value  # note  makes "# note" part of the value.

# --- Application ---------------------------------------------------------
# Picks .env.<environment> as well; "production" also switches logs to JSON.
APP_ENVIRONMENT=development

# --- Provider credentials: one key per provider, shared by bot and pipeline
# Google AI Studio (https://aistudio.google.com/apikey); has a free tier.
GEMINI_API_KEY=
GEMINI_PROXY=
# OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
OPENROUTER_PROXY=
# Mistral, for the pipeline's OCR stage only.
MISTRAL_API_KEY=

# --- Bot -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
# gemini (default) or openrouter; its key above must be set.
GRADER_PROVIDER=gemini
# Empty: Gemini Decision 1. Any decision model that accepts images.
GRADER_MODEL=
GRADER_REQUEST_TIMEOUT=30
GRADER_MAX_RETRIES=2
BOT_SESSION_IDLE_TTL_MINUTES=720

# --- Content pipeline ----------------------------------------------------
# gemini (default) or openrouter; its key above must be set.
LLM_PROVIDER=gemini
# Empty: gemini-2.5-flash-lite (gemini) or google/gemma-4-26b-a4b-it (openrouter).
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.95
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
OCR_MODEL=mistral-ocr-latest
BOOK_FILENAME=murphy.pdf
IMAGES_PAGES_DPI=300

# --- Paths (each defaults to a place under PATHS_DATA_DIR) ----------------
PATHS_DATA_DIR=data
# PATHS_DATABASE_PATH=data/content/english_practice.db

# --- Logging -------------------------------------------------------------
LOGGING_FILE_LEVEL=INFO
LOGGING_CONSOLE_LEVEL=INFO
LOGGING_FILE=logs/app.log

# --- Tracing (optional) --------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=english-practice
