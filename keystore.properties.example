# Copy to keystore.properties (gitignored) and fill in your signing key details.
# Keep the keystore OUTSIDE the repo, in ~/keystores/, named after the app.
# Use an absolute path with forward slashes; ~ is not expanded.
#
# Generate a key ONCE, only if you do not already have this app's release key:
#   keytool -genkeypair -v -storetype JKS \
#     -keystore ~/keystores/english-practice-release.jks -alias english-practice \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Development/CI work without this file; release publishing requires it.
# A replacement key changes the certificate pinned in scripts/android-signing.json
# and prevents updating existing installs signed with the previous key.

storeFile=C:/Users/<you>/keystores/english-practice-release.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=english-practice
keyPassword=REPLACE_WITH_KEY_PASSWORD
