# Not the stock GitHub Python list: entries like `lib/` and `var/` are setuptools-era
# and would silently swallow a real source directory.

# Project specific
# Track reviewed metadata and its audit record; keep source assets and scratch files local.
/data/*
!/data/content/
/data/content/*
!/data/content/metadata/
/data/content/metadata/*
!/data/content/metadata/answers_full.json
!/data/content/metadata/rules.json
!/data/manual-review/
/data/manual-review/*
!/data/manual-review/audit.json
!/data/manual-review/progress.json
!/data/manual-review/book-key-audit.json
drafts/
/models/
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class

# Packaging (uv build)
dist/

# Virtual environments (uv)
.venv/

# Environments; .env.example is the committed config contract.
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Type checking
.ty_cache/

# Ruff
.ruff_cache/

# Logs
*.log

# Secrets
*.key
*.pem
*.jks
*.keystore
*.p12
*-signing-password.xml
key.properties
/keystore.properties
secrets/
credentials/
.ssh/

# Claude Code personal files (may contain machine-specific paths or credentials).
# Creating a CLAUDE.local.md stops Claude Code from reading AGENTS.md, unless /config
# sets Project instructions to claude-md-and-agents-md.
.claude/settings.local.json
CLAUDE.local.md

# OS
.DS_Store
Thumbs.db
