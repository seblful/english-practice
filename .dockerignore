**/.venv/
.ruff_cache/
.pytest_cache/
.coverage
.claude/
.idea/
.vscode/
.ignore
.pre-commit-config.yaml
CLAUDE.md

# NOTE: README.md, LICENSE and uv.lock are intentionally NOT ignored -- the
# uv-based build reads uv.lock, and each package's pyproject.toml references
# both its readme and the license, so hatchling fails to build without them.
